# Copia este archivo como .env  →  cp .env.example .env
# .env está en .gitignore: nunca se sube a GitHub.

# Puerto de la API
PORT=3000

# Base de desarrollo (la levanta: docker compose up -d)
DATABASE_URL=postgres://app:app@localhost:5433/app

# Base de pruebas: las pruebas de integración y E2E la BORRAN cada vez
TEST_DATABASE_URL=postgres://app:app@localhost:5433/app_test

# true = muestra los mensajes de depuración (logger.debug). En producción: false
DEBUG=true
